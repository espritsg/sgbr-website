# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Postgres-Verbindung. Lokal: docker compose (Port 5433). Produktion: Neon über Vercel Marketplace.
DATABASE_URL=postgres://sgbr:sgbr@localhost:5433/sgbr

# Geheimer Schlüssel für Payload (Sessions, Tokens). Zufällig, mind. 32 Zeichen: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Öffentliche Adresse der Seite, ohne "/" am Ende. Produktion: https://stgallenbusinessreview.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Nur lokal
# ---------------------------------------------------------------------------

# Datenbank für automatisierte Tests (wird bei jedem Testlauf verändert).
DATABASE_URL_TEST=postgres://sgbr:sgbr@localhost:5433/sgbr_test

# Passwort für die Testbenutzer des Dev-Imports (admin@sgbr.local usw.). Nur lokal, frei wählbar.
DEV_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: KI-Zusammenfassungen im Import- und Migrationsskript
# ---------------------------------------------------------------------------

# Anthropic-API-Key (console.anthropic.com). Ohne Key: erster Absatz als Zusammenfassung.
ANTHROPIC_API_KEY=
# Modell für die Zusammenfassungen.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# E-Mail und Newsletter (Resend, auch Liste der Abonnenten: ADR 0021).
# Ohne RESEND_API_KEY: Mails nur in Konsole und .mail-preview/, Kontakte in .mail-preview/audience.json
# ---------------------------------------------------------------------------

# API-Key von resend.com (Konto von ESPRIT), Berechtigung „Full access“ (Kontakte und Broadcasts).
# Nur in Produktion setzen, lokal nie: sonst landen Test-Kontakte in der echten Liste.
RESEND_API_KEY=
# IDs aus `npm run resend:setup`: ein Segment pro Sprache, ein Topic pro Interesse.
RESEND_SEGMENT_EN=
RESEND_SEGMENT_DE=
RESEND_TOPIC_NEWSLETTER=
RESEND_TOPIC_EVENTS=
# Absender für normale Mails (Formulare, Bestätigungen, Passwort-Reset).
EMAIL_FROM=St. Gallen Business Review <editorial@stgallenbusinessreview.com>
# Absender der Newsletter-Broadcasts, eigene Subdomain bei Resend.
NEWSLETTER_FROM=St. Gallen Business Review <newsletter@news.stgallenbusinessreview.com>
# Antwortadresse des Newsletters.
NEWSLETTER_REPLY_TO=editorial@stgallenbusinessreview.com

# ---------------------------------------------------------------------------
# Hintergrund-Jobs
# ---------------------------------------------------------------------------

# Geheimnis für den täglichen Vercel Cron. Zufällig, z. B. `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# MCP-Schnittstelle für KI-Agents (/api/mcp). Standard aus.
MCP_ENABLED=false
# Dateien in Cloudflare R2 (ADR 0022). Ohne Zugang: lokale Ordner media/ und application-files/.
# Account-ID (R2-Übersicht) und API-Token „Object Read & Write“ für beide Buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Öffentliche Adresse des Buckets sgbr-media (r2.dev oder eigene Domain), ohne "/" am Ende.
R2_PUBLIC_URL=
# Optional: andere Bucket-Namen (Standard sgbr-media, sgbr-privat) oder Endpunkt
# (Standard https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com für Buckets in der EU).
# R2_BUCKET_MEDIA=
# R2_BUCKET_PRIVATE=
# R2_ENDPOINT=
