# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Postgres-Verbindung. Lokal: docker compose (Port 5433). Produktion: Neon über Vercel Marketplace.
DATABASE_URL=postgres://sgbr:sgbr@localhost:5433/sgbr

# Geheimer Schlüssel für Payload (Sessions, Tokens). Zufällig, mind. 32 Zeichen: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Öffentliche Adresse der Seite, ohne "/" am Ende. Produktion: https://stgallenbusinessreview.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Nur lokal
# ---------------------------------------------------------------------------

# Datenbank für automatisierte Tests (wird bei jedem Testlauf verändert).
DATABASE_URL_TEST=postgres://sgbr:sgbr@localhost:5433/sgbr_test
