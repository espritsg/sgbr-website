# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Postgres-Verbindung. Lokal: docker compose (Port 5433). Produktion: Neon über Vercel Marketplace.
DATABASE_URL=postgres://sgbr:sgbr@localhost:5433/sgbr

# Geheimer Schlüssel für Payload (Sessions, Tokens). Zufällig, mind. 32 Zeichen: `openssl rand -hex 32`
PAYLOAD_SECRET=

# Öffentliche Adresse der Seite, ohne "/" am Ende. Produktion: https://stgallenbusinessreview.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Nur lokal
# ---------------------------------------------------------------------------

# Datenbank für automatisierte Tests (wird bei jedem Testlauf verändert).
DATABASE_URL_TEST=postgres://sgbr:sgbr@localhost:5433/sgbr_test

# Passwort für die Testbenutzer des Dev-Imports (admin@sgbr.local usw.). Nur lokal, frei wählbar.
DEV_SEED_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: KI-Zusammenfassungen im Import- und Migrationsskript
# ---------------------------------------------------------------------------

# Anthropic-API-Key (console.anthropic.com). Ohne Key: erster Absatz als Zusammenfassung.
ANTHROPIC_API_KEY=
# Modell für die Zusammenfassungen.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# E-Mail und Newsletter (Resend). Ohne RESEND_API_KEY: nur Konsole und .mail-preview/
# ---------------------------------------------------------------------------

# API-Key von resend.com (Konto von ESPRIT). Nur in Produktion setzen.
RESEND_API_KEY=
# Signatur-Secret des Resend-Webhooks (Bounces, Spam). Webhook-URL: https://…/api/newsletter/webhook
RESEND_WEBHOOK_SECRET=
# Absender für normale Mails (Formulare, Bestätigungen, Passwort-Reset).
EMAIL_FROM=St. Gallen Business Review <editorial@stgallenbusinessreview.com>
# Absender des Newsletters, eigene Subdomain bei Resend.
NEWSLETTER_FROM=St. Gallen Business Review <newsletter@news.stgallenbusinessreview.com>
# Antwortadresse des Newsletters.
NEWSLETTER_REPLY_TO=editorial@stgallenbusinessreview.com

# ---------------------------------------------------------------------------
# Hintergrund-Jobs
# ---------------------------------------------------------------------------

# Geheimnis für den Vercel Cron und den Selbstaufruf des Newsletter-Versands. Zufällig, z. B. `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# MCP-Schnittstelle für KI-Agents (/api/mcp). Standard aus.
MCP_ENABLED=false
# Vercel Blob: Bilder, PDFs und (privat) Lebensläufe. Ohne Token: lokale Ordner media/ und application-files/.
BLOB_READ_WRITE_TOKEN=
