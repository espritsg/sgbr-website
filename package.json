{
  "name": "sgbr-website",
  "version": "1.0.0",
  "description": "Website der St. Gallen Business Review (Next.js, Payload CMS, Tailwind CSS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "import:dev": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/import-dev.ts",
    "check:redirects": "tsx src/scripts/check-redirects.ts",
    "jobs": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/run-jobs.ts",
    "build:vercel": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run build",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:wp": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/migrate.ts",
    "seed:forms": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-forms.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@payloadcms/admin-bar": "3.94.1",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/email-resend": "3.94.1",
    "@payloadcms/live-preview-react": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/plugin-cloud-storage": "3.94.1",
    "@payloadcms/plugin-form-builder": "3.94.1",
    "@payloadcms/plugin-import-export": "3.94.1",
    "@payloadcms/plugin-mcp": "3.94.1",
    "@payloadcms/plugin-redirects": "3.94.1",
    "@payloadcms/plugin-search": "3.94.1",
    "@payloadcms/plugin-seo": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/storage-vercel-blob": "3.94.1",
    "@payloadcms/translations": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.3.1",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "fast-xml-parser": "5.11.2",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "payload": "3.94.1",
    "pg": "8.20.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "6.39.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.19.9",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "28.0.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "private": true
}
