{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/run-jobs",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "src/app/(payload)/api/[...slug]/route.ts": {
      "maxDuration": 300
    }
  }
}
